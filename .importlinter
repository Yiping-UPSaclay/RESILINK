[importlinter]
root_packages =
    resilink
    resilink_ai
include_external_packages = True

[importlinter:contract:core-layers]
name = Core layering (deterministic core, blueprint §2; engine and plugin_api from ADR-0008)
type = layers
layers =
    cli
    ops
    views
    experiments
    engine
    risk
    cascade | fragility | dependencies | hazards | service | restoration | consequence
    network
    synthetic | knowledge | etl
    registry
    io
    systems | slots
    domain
    plugin_api
containers =
    resilink

[importlinter:contract:core-has-no-ui-web-queue-or-llm]
name = Core never imports UI / web / queue / LLM frameworks (invariants I3, I7)
type = forbidden
source_modules =
    resilink
forbidden_modules =
    streamlit
    pydeck
    altair
    fastapi
    starlette
    rq
    anthropic
    mcp
    claude_agent_sdk
    resilink_ai

[importlinter:contract:ai-layer-uses-ops-not-io-writers]
name = AI layer goes through the Operation Registry, never writes releases/results directly (invariant I2)
type = forbidden
source_modules =
    resilink_ai
forbidden_modules =
    resilink.io.release
    resilink.io.results
    resilink.io.geoparquet
allow_indirect_imports = True

[importlinter:contract:plugins-use-only-plugin-api]
name = Model plugins import only resilink.plugin_api from the core (ADR-0008, acceptance criterion AC9)
type = forbidden
source_modules =
    resilink.cascade
    resilink.consequence
    resilink.dependencies
    resilink.fragility
    resilink.hazards
    resilink.restoration
    resilink.service
forbidden_modules =
    resilink.cli
    resilink.ops
    resilink.views
    resilink.experiments
    resilink.engine
    resilink.risk
    resilink.network
    resilink.synthetic
    resilink.knowledge
    resilink.etl
    resilink.registry
    resilink.io
    resilink.systems
    resilink.slots
    resilink.domain
