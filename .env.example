# Copy to .env (never commit .env). The lab works without any of these (RESILINK_AI=off).
# AI layer — first-party Anthropic API (or run `ant auth login` instead of setting a key)
ANTHROPIC_API_KEY=
# EU-resident alternative (decision D24): Vertex AI project for the vertex_eu provider profile
GCP_PROJECT=
# Switch AI off entirely (capability parity: CLI / Ops console / MCP still work)
RESILINK_AI=on
# Optional overrides
RESILINK_DATA=
RESILINK_MCP_TIER=internal
RESILINK_MCP_AUTONOMY=compute
# Météo-France API portal key (needed from P2 for AROME / fire-weather inputs)
METEOFRANCE_API_KEY=
